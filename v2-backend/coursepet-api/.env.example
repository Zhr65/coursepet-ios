# 复制为 .env 后填写真实值（.env 不进 git）
DATABASE_URL=postgresql+psycopg2://zhr@localhost/coursepet

# 必填：>=32 位随机串，否则服务拒绝启动（config.py 里 fail-fast 校验）。生成：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# 注册开关：默认 false（安全默认）。需要开通新账号时临时改 true，注册完改回 false。
REGISTER_OPEN=false
