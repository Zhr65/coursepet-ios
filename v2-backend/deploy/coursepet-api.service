[Unit]
Description=CoursePet API (FastAPI + uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=zhr
WorkingDirectory=/home/zhr/coursepet-api
ExecStart=/home/zhr/coursepet-env/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
