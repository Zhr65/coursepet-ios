<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 连接器"软件"分组：canOpenURL 检测已装 App（上限 50 条，只列高置信 scheme） -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>meituanwaimai</string>
		<string>ctrip</string>
		<string>fliggy</string>
		<string>taobao</string>
		<string>openapp.jdmobile</string>
		<string>iosamap</string>
		<string>bilibili</string>
		<string>orpheus</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- URL Scheme：小组件/灵动岛点击直达（coursepet://schedule 等） -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.coursepet.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>coursepet</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>需要访问相册以设置宠物背景图片</string>
	<key>NSFileImportPickerUsageDescription</key>
	<string>需要选择 Excel 课表文件进行导入</string>
	<!-- 步数换奖励：CoreMotion 读取今日步数 -->
				<key>NSCalendarsUsageDescription</key>
		<string>只读同步系统日历日程，让宠物管家安排学习计划时不撞车</string>
		<key>NSCalendarsFullAccessUsageDescription</key>
		<string>只读同步系统日历日程，让宠物管家安排学习计划时不撞车</string>
<key>NSCameraUsageDescription</key>
	<string>拍照识别作业题、账单小票和课表，帮主人快速记录</string>
<key>NSMotionUsageDescription</key>
	<string>读取今日步数为宠物兑换奖励（数据仅在本机使用，不会上传）</string>
	<!-- 早八天气：定位一次获取经纬度查询 Open-Meteo 天气 -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>走进你设置的提醒点（如教学楼）附近时，提醒下一节课的安排（定位仅在本机使用，不会上传）</string>
<key>NSLocationWhenInUseUsageDescription</key>
	<string>获取当前位置以查询本地天气（仅用于天气提醒，不会上传定位）</string>
	<!-- 语音记账：SpeechFramework 端侧识别口语句 -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把说的话转成文字用于快速记账（优先端侧识别，语音数据不会上传）</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>录音用于语音记账（仅在本机处理，不会上传录音）</string>
	<!-- 课表截图导入：PhotosPicker 选图 + Vision OCR 识别（无额外权限需求） -->
</dict>
</plist>
